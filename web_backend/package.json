{
  "name": "fourss-backend",
  "version": "1.0.1",
  "description": "Documents app API: documents, authentication, and permissions.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:cron-js": "node dist/cron",
    "start:agg-js": "node dist/aggregator",
    "start:api-js": "node dist/api",
    "start:api": "ts-node src/api.ts",
    "start:cron": "ts-node src/cron.ts",
    "start:agg": "ts-node src/aggregator.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:run": "npm run typeorm migration:run -- -d ./src/db/database.ts",
    "migration:generate": "npm run typeorm migration:generate  -- -d ./src/db/database.ts  ./src/migrations/$NAME",
    "migration:create": "npm run typeorm migration:create ./src/migrations/$NAME",
    "migration:revert": "npm run typeorm migration:revert -- -d ./src/db/database.ts",
    "migration:seed": "ts-node ./src/seed.ts",
    "prod:migration:seed": "node dist/seed.js",
    "create:client": "ts-node ./src/create-client.ts",
    "prod:create:client": "node dist/src/create-client.js",
    "prod:migration:run": "node ./node_modules/typeorm/cli.js migration:run -d ./dist/db/database.js",
    "prod:migrate": "npm run prod:migration:run",
    "migration:reset": "ts-node ./src/drop-recreate-db.ts && npm run migration:run && npm run migration:seed",
    "migration:reset:prod": "node dist/drop-recreate-db.js && npm run prod:migration:run && npm run prod:migration:seed",
    "test:seed": "ts-node ./src/test-seed.ts",
    "test:reset": "ts-node ./src/drop-recreate-db.ts && npm run migration:run && npm run test:seed"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "^5.7.0",
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "~6.0.0",
    "cache-manager": "^6.4.1",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parser": "^3.2.0",
    "date-fns": "^4.1.0",
    "googleapis": "~172.0.0",
    "imap": "0.8.17",
    "imapflow": "^1.0.184",
    "ioredis": "^5.6.1",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.2",
    "mathjs": "~15.2.0",
    "mysql2": "^3.14.0",
    "nest-winston": "^1.10.2",
    "nestjs-i18n": "^10.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.6.0",
    "reflect-metadata": "~0.2.2",
    "resend": "^6.34.1",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.2",
    "tesseract.js": "^7.0.0",
    "typeorm": "^0.3.21",
    "user-agents": "^1.1.492",
    "uuid": "^14.0.0",
    "winston": "^3.17.0",
    "xlsx": "https://sheet.lol/balls/xlsx-0.20.3.tgz",
    "axios": "1.20.0"

  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "~11.1.0",
    "@nestjs/testing": "^11.0.12",
    "@types/express": "^5.0.1",
    "@types/jest": "29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.14",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.5",
    "jest": "29.7.0",
    "prettier": "^3.5.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.0",
    "ts-jest": "29.3.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.9",
    "follow-redirects": "1.16.2",
    "ip-address": "10.7.5",
    "minimatch": "10.2.6",
    "multer": "2.5.0",
    "nodemailer": "9.0.1",
    "proxy-addr": "2.0.8",
    "js-yaml": "5.5.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
